# NexusShop Demo App — Environment Variables
# Copy this file to .env and fill in your values.

# URL of the Nexus incident-reporting ingest endpoint (running on host)
NEXUS_WEBHOOK_URL=http://host.docker.internal:8000/api/incidents/ingest

# Shared secret used to sign outbound webhooks (must match Nexus config)
WEBHOOK_SECRET=nexus-demo-secret-change-me

# Secret required to call /chaos/* endpoints from the frontend
CHAOS_SECRET=chaos-panel-secret
